# ==============================================================
#  ZUST-login 二次开发项目 .gitignore
#  原则：只提交源码与文档，凭据 / 日志 / IDE / 缓存一律不提交
# ==============================================================

# --------------------------------------------------------------
# 1. 敏感凭据（最高优先级，绝不可提交）
# --------------------------------------------------------------
# 校园网账号密码明文配置，只保留模板 auth.example.json
auth.json
!auth.example.json

# 其他本地密钥 / 凭据文件
.env
.env.*
!.env.example
secrets.json
*.pem
*.key
*.p12
*.pfx
cookies.txt

# --------------------------------------------------------------
# 2. 运行产物（loguru 日志含轮转文件、含账号信息，必须忽略）
# --------------------------------------------------------------
*.log
srun_login.*.log
logs/
*.pid

# --------------------------------------------------------------
# 3. Python
# --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# 虚拟环境
.venv/
venv/
env/
ENV/
.conda/
*.egg-link

# --------------------------------------------------------------
# 4. JetBrains / PyCharm
# --------------------------------------------------------------
.idea/
# 若希望共享代码风格，可改为只保留以下文件：
# .idea/!codeStyles/
# .idea/!inspectionProfiles/
*.iml
*.ipr
*.iws
out/

# --------------------------------------------------------------
# 5. VS Code / 其他编辑器
# --------------------------------------------------------------
.vscode/
*.swp
*.swo
*~
.history/

# --------------------------------------------------------------
# 6. Windows / macOS 系统垃圾
# --------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride

# --------------------------------------------------------------
# 7. 临时 / 备份文件
# --------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.zip
*.7z
*.rar
debug_*.json
